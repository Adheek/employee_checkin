@{
    ViewData["Title"] = "Map Asset";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>MAP Asset</title>

    <!-- Styles -->
    <link rel="stylesheet" href="~/css/default.css"/>
    <link rel="stylesheet" href="~/css/default1.css"/>
    <link rel="stylesheet" href="~/css/default2.css"/>
    <link rel="stylesheet" href="~/css/site.css"/>
    <link rel="stylesheet" href="~/css/style.css"/>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet"/>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"/>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"/>

    <!-- jQuery + jQuery UI -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css"/>
</head>
<body>
    <!-- Inline Styles (optional) -->
    <style>
        body {
            font-family: 'Poppins', sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            padding: 0;
        }

        /* Tabs */
        .tabs {
            display: flex;
            justify-content: center;
            gap: 20px;
            margin-top: 20px;
        }
        .tab-button {
            padding: 10px 20px;
            border: none;
            cursor: pointer;
            background-color: #ddd;
            transition: all 0.3s ease-in-out;
            border-radius: 5px;
        }
        .tab-button.active {
            background-color: #1b6ec2;
            color: white;
        }
        .tab-content {
            display: none;
            padding: 20px;
        }
        .tab-content.active {
            display: block;
        }

        /* Table */
        .table-container {
            width: 100%;
            overflow-x: auto;
        }
        .asset-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        .asset-table th,
        .asset-table td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }
        .asset-table th {
            background-color: #1b6ec2;
            color: white;
        }

        /* Form */
        .form-group {
            margin-bottom: 15px;
        }
        .form-control {
            width: 100%;
            padding: 8px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        .btn-primary {
            background-color: #1b6ec2;
            border: none;
            padding: 10px 20px;
            color: white;
            cursor: pointer;
            border-radius: 5px;
        }
        .btn-primary:hover {
            background-color: #0f5ca5;
        }
        .btn-secondary {
            background-color: #6c757d;
            border: none;
            padding: 10px 20px;
            color: white;
            cursor: pointer;
            border-radius: 5px;
        }
        .btn-secondary:hover {
            background-color: #565e64;
        }

        /* Scanner Container */
        .qr-scanner-container {
            display: none;
            margin-top: 20px;
            text-align: center;
        }
    </style>

    <!-- Main Tabs -->
    <div class="tabs">
        <button class="tab-button active" data-tab="mappedList">
            <i class="fas fa-list"></i> Mapped Assets
        </button>
        <button class="tab-button" data-tab="mapNewAsset">
            <i class="fas fa-plus"></i> Map New Asset
        </button>
    </div>

    <!-- Mapped Assets List Tab -->
    <div id="mappedList" class="tab-content active">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="searchMappedAsset" placeholder="Search mapped assets...">
        </div>
        <div class="table-container">
            <table class="asset-table">
                <thead>
                    <tr>
                        <th>Asset ID</th>
                        <th>Asset Name</th>
                        <th>Employee ID</th>
                        <th>Employee Name</th>
                        <th>Department</th>
                        <th>Mapping Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="mappedAssetTableBody"></tbody>
            </table>
        </div>
    </div>

    <!-- Map New Asset Tab -->
    <div id="mapNewAsset" class="tab-content">
        <div class="section-tabs">
            <button class="section-tab active" data-section="scanAsset">Scan Asset</button>
            <button class="section-tab" data-section="manualEntry">Manual Entry</button>
        </div>

        <!-- Scan Asset Section -->
        <div id="scanAsset" class="section-content active">
            <div class="scan-controls">
                <button type="button" class="btn-primary" id="startAssetScan">
                    <i class="fas fa-camera"></i> Start QR Scanner
                </button>
                <div class="upload-control">
                    <label for="qrImageUpload" class="btn-secondary">
                        <i class="fas fa-upload"></i> Upload QR Image
                    </label>
                    <input type="file" id="qrImageUpload" accept="image/*" style="display: none;">
                </div>
            </div>
            <div class="qr-scanner-container" id="assetQrScanner">
                <button type="button" class="close-scanner-btn" id="closeScannerBtn">
                    <i class="fas fa-times"></i>
                </button>
                <div id="qr-reader"></div>
                <div class="scanner-status">
                    <p>Position the QR code within the frame</p>
                </div>
            </div>
            <div class="form-section">
                <h3>Scan QR Code</h3>
                <div class="scanner-container">
                    <div id="qr-reader"></div>
                </div>
                <div class="scanned-info">
                    <div class="form-grid">
                        <div class="form-group">
                            <label>Scanned Asset ID</label>
                            <input type="text" id="scannedAssetId" readonly>
                        </div>
                        <div class="form-group">
                            <label>Asset Name</label>
                            <input type="text" id="scannedAssetName" readonly>
                        </div>
                    </div>
                </div>
            </div>
            <div class="form-section">
                <h3>Employee Details</h3>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="scannedEmployeeId">Employee ID*</label>
                        <input type="text" id="scannedEmployeeId" required>
                    </div>
                    <div class="form-group">
                        <label for="scannedDepartment">Department*</label>
                        <input type="text" id="scannedDepartment" required>
                    </div>
                </div>
            </div>
        </div>

        <!-- Manual Entry Section -->
        <div id="manualEntry" class="section-content">
            <div class="form-section">
                <h3>Asset Information</h3>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="manualAssetId">Asset ID*</label>
                        <input type="text" id="manualAssetId" class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label for="manualAssetName">Asset Name</label>
                        <input type="text" id="manualAssetName" class="form-control" readonly />
                    </div>
                </div>
            </div>
            <div class="form-section">
                <h3>Employee Information</h3>
                <div class="form-grid">
                    <div class="form-group">
                        <label for="manualEmployeeId">Employee ID*</label>
                        <input type="text" id="manualEmployeeId" class="form-control" required />
                    </div>
                    <div class="form-group">
                        <label for="manualEmployeeName">Employee Name</label>
                        <input type="text" id="manualEmployeeName" class="form-control" readonly />
                    </div>
                </div>
            </div>
            <div class="form-actions">
                <button type="button" class="btn-secondary" onclick="switchTab('mappedList')">Cancel</button>
                <button type="button" class="btn-primary" id="confirmMapping">
                    <i class="fas fa-link"></i> Map Asset
                </button>
            </div>
        </div>
    </div>

    <script>
        // Runs once the DOM is fully loaded
        document.addEventListener("DOMContentLoaded", function () {

            // 1. Immediately load mapped assets so the user sees them on page load.
            loadMappedAssets();

            // 2. Tab Switching Logic (Mapped Assets vs Map New Asset)
            const tabButtons = document.querySelectorAll(".tab-button");
            const tabContents = document.querySelectorAll(".tab-content");
            tabButtons.forEach(button => {
                button.addEventListener("click", function () {
                    // Remove active from all
                    tabButtons.forEach(btn => btn.classList.remove("active"));
                    tabContents.forEach(content => content.classList.remove("active"));

                    // Add active to the clicked tab and its content
                    this.classList.add("active");
                    document.getElementById(this.dataset.tab).classList.add("active");
                });
            });

            // 3. Section Tab Switching (Scan Asset vs Manual Entry)
            const sectionButtons = document.querySelectorAll(".section-tab");
            const sectionContents = document.querySelectorAll(".section-content");
            sectionButtons.forEach(button => {
                button.addEventListener("click", function () {
                    sectionButtons.forEach(btn => btn.classList.remove("active"));
                    sectionContents.forEach(content => content.classList.remove("active"));

                    this.classList.add("active");
                    document.getElementById(this.dataset.section).classList.add("active");
                });
            });

            // 4. QR Scanner Show/Hide
            const startScannerBtn = document.getElementById("startAssetScan");
            const closeScannerBtn = document.getElementById("closeScannerBtn");
            const qrScannerContainer = document.getElementById("assetQrScanner");
            if (startScannerBtn && closeScannerBtn) {
                startScannerBtn.addEventListener("click", function () {
                    qrScannerContainer.style.display = "block";
                });
                closeScannerBtn.addEventListener("click", function () {
                    qrScannerContainer.style.display = "none";
                });
            }

            // 5. Search Filter for Mapped Assets
            $("#searchMappedAsset").on("keyup", function () {
                var value = $(this).val().toLowerCase();
                $("#mappedAssetTableBody tr").filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });

        // AJAX: Load Mapped Assets
        function loadMappedAssets() {
            $.ajax({
                url: '/api/EmployeeAssetMapping/mappedAssets',
                type: 'GET',
                success: function (data) {
                    // Clear existing table rows
                    $('#mappedAssetTableBody').empty();
                    // Populate table
                    data.forEach(function (item) {
                        var row = `
                            <tr>
                                <td>${item.assetId}</td>
                                <td>${item.assetName}</td>
                                <td>${item.employeeId}</td>
                                <td>${item.employeeName}</td>
                                <td>${item.department}</td>
                                <td>${new Date(item.mappingDate).toLocaleDateString()}</td>
                                <td><!-- Actions: add edit/delete if needed --></td>
                            </tr>`;
                        $('#mappedAssetTableBody').append(row);
                    });
                },
                error: function (err) {
                    console.log("Error loading mapped assets", err);
                }
            });
        }

        // Autocomplete for Asset ID
        $(document).ready(function () {
            $("#manualAssetId").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/api/fullData/searchAssets',
                        data: { term: request.term },
                        success: function (data) {
                            response(data);
                        },
                        error: function () {
                            response([]);
                        }
                    });
                },
                minLength: 1,
                select: function (event, ui) {
                    $("#manualAssetId").val(ui.item.value);
                    $("#manualAssetName").val(ui.item.assetName);
                    event.preventDefault();
                }
            });
        });

        // Autocomplete for Employee ID
        $(document).ready(function () {
            $("#manualEmployeeId").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: "/api/employee/searchEmployees",
                        data: { term: request.term },
                        success: function (data) {
                            response(data);
                        },
                        error: function () {
                            response([]);
                        }
                    });
                },
                minLength: 1,
                select: function (event, ui) {
                    $("#manualEmployeeId").val(ui.item.value);
                    $("#manualEmployeeName").val(ui.item.employeeName);
                    event.preventDefault();
                }
            });
        });

        // Map Asset (Manual Entry) Handler
        $(document).ready(function () {
            $("#confirmMapping").on("click", function () {
                var employeeId = parseInt($("#manualEmployeeId").val(), 10);
                var assetId = $("#manualAssetId").val();
                var createdBy = "system"; // Hard-coded example

                var payload = {
                    EmployeeId: employeeId,
                    AssetId: assetId,
                    CreatedBy: createdBy
                };

                $.ajax({
                    url: "/api/EmployeeAssetMapping/mapAsset",
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(payload),
                    success: function (result) {
                        alert("Mapping successfully created!");
                        // Reload the mapped assets list
                        location.reload();
                    },
                    error: function (err) {
                        alert("Error while mapping asset: " + err.responseText);
                    }
                });
            });
        });

        // (Optional) Additional logic for scanning (if you implement scanning in JS)
        function switchTab(tabId) {
            // Utility function to switch main tabs if needed
            $(".tab-button").removeClass("active");
            $(".tab-content").removeClass("active");
            $(`[data-tab='${tabId}']`).addClass("active");
            $(`#${tabId}`).addClass("active");
        }
    </script>
</body>
</html>

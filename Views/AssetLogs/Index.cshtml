<!DOCTYPE html>
@{
    ViewData["Title"] = "Asset Logs";
    Layout = null;
}
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>@ViewData["Title"]</title>
  <link rel="stylesheet" href="~/css/site.css" />
  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
  />
  <style>
    /* Global Font */
    * {
      font-family: 'Poppins', sans-serif;
      box-sizing: border-box;
    }

    /* Modal Styles */
    .modal {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(244, 241, 234, 0.95);
      z-index: 1000;
      padding: 0 1rem;
    }
    .modal-content {
      background: #faf9f6;
      margin: 2rem auto;
      padding: 2rem;
      border: 1px solid #e0dcd3;
      border-radius: 12px;
      width: 95%;
      max-width: 1200px;
      height: calc(100vh - 4rem);
      overflow-y: auto;
      position: relative;
      color: #333333;
    }
    .modal-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
      padding-bottom: 1rem;
      border-bottom: 1px solid #e0dcd3;
    }
    .modal-header h2 {
      color: #0d0063;
      font-size: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .close-btn {
      background: none;
      border: none;
      color: #666666;
      font-size: 1.5rem;
      cursor: pointer;
      transition: color 0.3s;
    }
    .close-btn:hover {
      color: #0d0063;
    }

    /* Filter/Download/Clear Controls */
    .controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1rem;
    }
    .controls label {
      font-weight: 500;
      margin-right: 0.5rem;
    }
    .controls input[type="date"] {
      padding: 0.3rem;
      font-size: 0.9rem;
      border: 1px solid #ccc;
      border-radius: 4px;
    }
    .controls button {
      padding: 0.6rem 1rem;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      background: #0d0063;
      color: #ffffff;
      font-size: 0.9rem;
    }

    /* Table Styles */
    .table-container {
      overflow-x: auto;
      background: #ffffff;
      border: 1px solid #e0dcd3;
      border-radius: 8px;
    }
    .logs-table {
      width: 100%;
      border-collapse: collapse;
    }
    .logs-table th,
    .logs-table td {
      padding: 1rem;
      text-align: left;
      border-bottom: 1px solid #e0dcd3;
    }
    .logs-table th {
      background: #0d0063;
      color: #ffffff;
      font-weight: 500;
    }
  </style>
</head>
<body>
  <!-- Asset Logs Modal -->
  <div id="logsModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2>
          <i class="fas fa-history"></i> Asset Logs
        </h2>
        <button class="close-btn" id="closeLogsModal">&times;</button>
      </div>

      <!-- Filter and Download Controls -->
      <div class="controls">
        <!-- Start Date -->
        <div>
          <label for="startDate">Start Date:</label>
          <input type="date" id="startDate" />
        </div>
        <!-- End Date -->
        <div>
          <label for="endDate">End Date:</label>
          <input type="date" id="endDate" />
        </div>
        <!-- Filter Button -->
        <button id="filterButton">
          <i class="fas fa-filter"></i> Filter
        </button>
        <!-- Download Button -->
        <button id="downloadButton">
          <i class="fas fa-download"></i> Download
        </button>
        <!-- Clear Filter Button -->
        <button id="clearFilterButton">
          <i class="fas fa-ban"></i> Clear Filter
        </button>
      </div>

      <!-- Table Container -->
      <div class="table-container">
        <table class="logs-table">
          <thead>
            <tr>
              <th>ScanId</th>
              <th>AssetId</th>
              <th>EmployeeId</th>
              <th>EmployeeName</th>
              <th>TransactionTime</th>
              <th>TransactionType</th>
            </tr>
          </thead>
          <tbody id="logsTableBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    // Close the modal and redirect back to Landing when close button is clicked.
    document.getElementById('closeLogsModal').addEventListener('click', function () {
      window.location.href = "/Home/Landing";
    });

    // Keep a global array to store fetched logs.
    let allLogs = [];

    // Helper to format date to YYYY-MM-DD for input fields
    function formatDateForInput(date) {
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    // Set default dates: Start = 3 days ago, End = today
    const today = new Date();
    const past3Days = new Date();
    past3Days.setDate(today.getDate() - 3);

    // Initialize date fields
    const startDateInput = document.getElementById('startDate');
    const endDateInput = document.getElementById('endDate');
    startDateInput.value = formatDateForInput(past3Days);
    endDateInput.value = formatDateForInput(today);

    // Fetch logs on page load
    window.addEventListener('DOMContentLoaded', () => {
      fetchLogs();
    });

    // Fetch logs from /api/ScanDetails/All
    function fetchLogs() {
      fetch('/api/ScanDetails/All')
        .then((response) => {
          if (!response.ok) {
            return response.text().then((text) => {
              throw new Error(text);
            });
          }
          return response.json();
        })
        .then((data) => {
          allLogs = data;
          renderLogs(allLogs);
        })
        .catch((error) => {
          console.error('Error fetching logs:', error);
          alert("Error fetching logs. Please try again later.");
        });
    }

    // Render logs to table
    function renderLogs(logs) {
      const tbody = document.getElementById('logsTableBody');
      tbody.innerHTML = ''; // Clear existing rows

      logs.forEach((log) => {
        const tr = document.createElement('tr');
        const transactionTime = new Date(log.transactionTime).toLocaleString();
        tr.innerHTML = `
          <td>${log.scanId}</td>
          <td>${log.assetId}</td>
          <td>${log.employeeId || ''}</td>
          <td>${log.employeeName}</td>
          <td>${transactionTime}</td>
          <td>${log.transactionType}</td>
        `;
        tbody.appendChild(tr);
      });
    }

    // Filter button event
    document.getElementById('filterButton').addEventListener('click', () => {
      const startDateStr = startDateInput.value;
      const endDateStr = endDateInput.value;

      if (!startDateStr || !endDateStr) {
        alert('Please select both start and end dates.');
        return;
      }

      const startDate = new Date(startDateStr);
      // Set time to 00:00 for start date
      startDate.setHours(0, 0, 0, 0);

      const endDate = new Date(endDateStr);
      // Set time to 23:59 for end date
      endDate.setHours(23, 59, 59, 999);

      // Filter logs in the client based on date range
      const filteredLogs = allLogs.filter((log) => {
        const tTime = new Date(log.transactionTime);
        return tTime >= startDate && tTime <= endDate;
      });

      renderLogs(filteredLogs);
    });

    // Download button event
    document.getElementById('downloadButton').addEventListener('click', () => {
      // Read the currently displayed rows from the table
      const rows = document.querySelectorAll('#logsTableBody tr');

      // Construct an array of objects from the displayed rows
      const displayedLogs = [];
      rows.forEach((row) => {
        const cells = row.querySelectorAll('td');
        displayedLogs.push({
          ScanId: cells[0].textContent.trim(),
          AssetId: cells[1].textContent.trim(),
          EmployeeId: cells[2].textContent.trim(),
          EmployeeName: cells[3].textContent.trim(),
          TransactionTime: cells[4].textContent.trim(),
          TransactionType: cells[5].textContent.trim()
        });
      });

      // Convert displayedLogs to CSV
      const csvRows = [];
      // Header
      csvRows.push([
        'ScanId',
        'AssetId',
        'EmployeeId',
        'EmployeeName',
        'TransactionTime',
        'TransactionType'
      ].join(','));

      // Data
      displayedLogs.forEach(log => {
        csvRows.push([
          log.ScanId,
          log.AssetId,
          log.EmployeeId,
          log.EmployeeName,
          log.TransactionTime,
          log.TransactionType
        ].join(','));
      });

      const csvString = csvRows.join('\n');

      // Create a blob and download
      const blob = new Blob([csvString], { type: 'text/csv' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'AssetLogs.csv';
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      URL.revokeObjectURL(url);
    });

    // Clear Filter button event
    document.getElementById('clearFilterButton').addEventListener('click', () => {
      // Reset the date fields to the default range
      startDateInput.value = formatDateForInput(past3Days);
      endDateInput.value = formatDateForInput(today);

      // Re-fetch all logs from the server
      fetchLogs();
    });
  </script>
</body>
</html>

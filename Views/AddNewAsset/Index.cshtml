@{
    ViewData["Title"] = "Add New Asset";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
</head>

<body>
    <!-- Modal Container -->
    <div id="deviceModal" class="modal">
        <div class="modal-content">
            <!-- Header -->
            <div class="modal-header">
                <h2>
                    <i class="fas fa-laptop"></i>
                    Asset Management
                </h2>
                <button class="close-btn" id="closeDeviceModal">&times;</button>
            </div>

            <!-- Main Tabs -->
            <div class="tabs">
                <button class="tab-button active" data-tab="assetList">
                    <i class="fas fa-list"></i> Asset List
                </button>
                <button class="tab-button" data-tab="addAsset">
                    <i class="fas fa-plus"></i> Add New Asset
                </button>
                <button class="tab-button" data-tab="bulkUploadAsset">
                    <i class="fas fa-plus"></i> Bulk Upload Asset
                </button>
            </div>

            <!-- Asset List Tab Content -->
            <div id="assetList" class="tab-content active">
                <div class="search-box">
                    <i class="fas fa-search"></i>
                    <input type="text" id="searchAsset" placeholder="Search assets~.">
                </div>
                <div class="table-container">
                    <table class="asset-table">
                        <thead>
                            <tr>
                                <th>Asset ID</th>
                                <th>Asset Name</th>
                                <th>Category</th>
                                <th>Status</th>
                                <th>Location</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody id="assetTableBody"></tbody>
                    </table>
                </div>
            </div>

            <!-- Add Asset Tab Content -->
            <div id="addAsset" class="tab-content">
                <!-- Button to fill sample data (optional for testing) -->
                <button type="button" id="fillSampleDataBtn" class="btn-secondary" style="margin-bottom:1rem;">
                    Fill Sample Data
                </button>

                <form id="fullDataForm" class="full-data-form">
                    <!-- Category Details Section -->
                    <h2>Category Details</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="categoryName">Category Name*</label>
                            <input type="text" id="categoryName" name="categoryName" required autocomplete="off">
                        </div>
                    </div>

                    <!-- Vendor Details Section -->
                    <h2>Vendor Details</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="vendorName">Vendor Name*</label>
                            <input type="text" id="vendorName" name="vendorName" required autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="vendorType">Vendor Type (e.g., Manufacturer, Supplier)*</label>
                            <input type="text" id="vendorType" name="vendorType" required autocomplete="off">
                        </div>
                    </div>

                    <!-- Location Details Section -->
                    <h2>Location Details</h2>
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="country">Country*</label>
                            <input type="text" id="country" name="country" required autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="state">State*</label>
                            <input type="text" id="state" name="state" required autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="city">City*</label>
                            <input type="text" id="city" name="city" required autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="address">Address*</label>
                            <input type="text" id="address" name="address" required autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="zipCode">ZIP Code</label>
                            <input type="text" id="zipCode" name="zipCode" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="locationType">Location Type</label>
                            <input type="number" id="locationType" name="locationType" autocomplete="off">
                        </div>
                    </div>

                    <!-- Asset Details Section -->
                    <h2>Asset Details</h2>
                    <div class="form-grid">
                        <!-- Basic Asset Information -->
                        <div class="form-group">
                            <label for="companyName">Company Name</label>
                            <input type="text" id="companyName" name="companyName" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="assetName">Asset Name*</label>
                            <input type="text" id="assetName" name="assetName" required autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="assetTag">Asset Tag</label>
                            <input type="text" id="assetTag" name="assetTag" autocomplete="off">
                        </div>
                        <!-- Device Details -->
                        <div class="form-group">
                            <label for="model">Model</label>
                            <input type="text" id="model" name="model" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="modelNo">Model Number</label>
                            <input type="text" id="modelNo" name="modelNo" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="serialNumber">Serial Number</label>
                            <input type="text" id="serialNumber" name="serialNumber" autocomplete="off">
                        </div>
                        <!-- Purchase & Status Details -->
                        <div class="form-group">
                            <label for="purchasedDate">Purchased Date</label>
                            <input type="date" id="purchasedDate" name="purchasedDate">
                        </div>
                        <div class="form-group">
                            <label for="cost">Cost</label>
                            <input type="number" id="cost" name="cost" step="0.01">
                        </div>
                        <div class="form-group">
                            <label for="eol">End of Life (EOL)</label>
                            <input type="date" id="eol" name="eol">
                        </div>
                        <div class="form-group">
                            <label for="orderNumber">Order Number</label>
                            <input type="text" id="orderNumber" name="orderNumber" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="status">Status*</label>
                            <select id="status" name="status" required>
                                <option value="Available">Available</option>
                                <option value="In Use">In Use</option>
                                <option value="Maintenance">Maintenance</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="warrantyPeriod">Warranty Period (months)</label>
                            <input type="number" id="warrantyPeriod" name="warrantyPeriod" autocomplete="off">
                        </div>
                        <div class="form-group">
                            <label for="warrantyExpires">Warranty Expires</label>
                            <input type="date" id="warrantyExpires" name="warrantyExpires">
                        </div>
                        <div class="form-group">
                            <label for="currentValue">Current Value</label>
                            <input type="number" id="currentValue" name="currentValue" step="0.01">
                        </div>
                        <div class="form-group">
                            <label for="fullyDepreciated">Fully Depreciated</label>
                            <input type="checkbox" id="fullyDepreciated" name="fullyDepreciated">
                        </div>
                        <div class="form-group">
                            <label for="lastAudit">Last Audit Date</label>
                            <input type="date" id="lastAudit" name="lastAudit">
                        </div>
                        <div class="form-group">
                            <label for="nextAuditDate">Next Audit Date</label>
                            <input type="date" id="nextAuditDate" name="nextAuditDate">
                        </div>
                        <div class="form-group full-width">
                            <label for="notes">Notes</label>
                            <textarea id="notes" name="notes" rows="4"></textarea>
                        </div>
                    </div>

                    <!-- Form Actions -->
                    <div class="form-actions">
                        <button type="button" class="btn-secondary" onclick="switchTab('assetList')">Cancel</button>
                        <button type="submit" class="btn-primary">
                            <i class="fas fa-plus"></i> Submit
                        </button>
                    </div>
                </form>
            </div>

            <!-- Bulk Asset Upload Tab Content -->
            <div id="bulkUploadAsset" class="tab-content">
                <form id="bulkUploadForm" class="full-data-form" enctype="multipart/form-data"> 
                    <!-- Button to upload the excel file --> 
                    <input type="file" name="Files" /> 
                    <button type="submit" id="uploadExcelTemplateFileBtn" class="btn-primary"> 
                        Upload Excel Template
                    </button> 
                </form>
            </div>
        </div>
    </div>
    <style>
         /* Modal Styles */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(244, 241, 234, 0.95);
            z-index: 1000;
            padding: 0 1rem;
        }

        .modal-content {
            background: #faf9f6;
            margin: 2rem auto;
            padding: 2rem;
            border: 1px solid #e0dcd3;
            border-radius: 12px;
            width: 95%;
            max-width: 1200px;
            height: calc(100vh - 4rem);
            max-height: none;
            overflow-y: auto;
            position: relative;
            color: #333333;
        }

        /* Modal Header */
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 1px solid #e0dcd3;
        }

        .modal-header h2 {
            color: #0d0063;
            font-size: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .close-btn {
            background: none;
            border: none;
            color: #666666;
            font-size: 1.5rem;
            cursor: pointer;
            transition: color 0.3s;
        }

        /* Tabs Styles */
        .tabs {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            border-bottom: 1px solid #e0dcd3;
            padding-bottom: 0.5rem;
        }

        .tab-button {
            background: none;
            border: none;
            color: #666666;
            padding: 0.75rem 1.5rem;
            cursor: pointer;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            border-bottom: 2px solid transparent;
            transition: all 0.3s;
        }

        .tab-button.active {
            color: #0d0063;
            border-bottom-color: #0d0063;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        /* Section Tabs */
        .section-tabs {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 2rem;
            border-bottom: 1px solid #e0dcd3;
            padding-bottom: 0.5rem;
        }

        .section-tab {
            background: none;
            border: none;
            color: #666666;
            padding: 0.75rem 1.5rem;
            cursor: pointer;
            font-size: 0.9rem;
            border-bottom: 2px solid transparent;
            transition: all 0.3s;
        }

        .section-tab:hover {
            color: #0d0063;
        }

        .section-tab.active {
            color: #0d0063;
            border-bottom-color: #0d0063;
        }

        .section-content {
            display: none;
            padding: 1.5rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
        }

        .section-content.active {
            display: block;
        }

        /* Form Styles */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
        }

        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: #666666;
            font-size: 0.9rem;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 0.8rem;
            background: #faf9f6;
            border: 1px solid #e0dcd3;
            border-radius: 6px;
            color: #333333;
            font-size: 0.9rem;
            transition: all 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: #0d0063;
            box-shadow: 0 0 0 2px rgba(13, 0, 99, 0.2);
            outline: none;
        }

        .form-group.full-width {
            grid-column: 1 / -1;
        }

        /* Button Styles */
        .btn-primary,
        .btn-secondary {
            padding: 0.8rem 1.5rem;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.9rem;
            transition: all 0.3s;
        }

        .btn-primary {
            background: #0d0063;
            color: white;
        }

        .btn-secondary {
            background: #f4f1ea;
            color: #333333;
            border: 1px solid #e0dcd3;
        }

        .btn-danger {
            background: #dc3545;
            color: white;
        }

        .btn-primary:hover {
            background: #0a004d;
        }

        .btn-secondary:hover {
            background: #e0dcd3;
        }

        .btn-danger:hover {
            background: #bb2d3b;
        }

        /* Table Styles */
        .table-container {
            overflow-x: auto;
            background: #ffffff;
            border: 1px solid #e0dcd3;
        }

        .asset-table {
            width: 100%;
            border-collapse: collapse;
        }

        .asset-table th,
        .asset-table td {
            padding: 1rem;
            text-align: left;
            border-bottom: 1px solid #e0dcd3;
        }

        .asset-table th {
            background: #0d0063;
            color: #ffffff;
            font-weight: 500;
            white-space: nowrap;
        }

        .asset-table tr:hover {
            background: #f4f1ea;
        }

        /* Search Box Styles */
        .search-box {
            position: relative;
            max-width: 500px;
            margin-bottom: 1.5rem;
        }

        .search-box i {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #666666;
        }

        .search-box input {
            width: 100%;
            padding: 0.8rem 1rem 0.8rem 2.5rem;
            background: #ffffff;
            border: 1px solid #e0dcd3;
            border-radius: 6px; 
            color: #333333;
        }

        /* Responsive Design */
        @@media(max - width: 768px) {
                .modal-content {
                    margin: 1rem;
                    padding: 1.5rem;
                }

                .form-grid {
                    grid-template-columns: 1fr;
                }

                .form-actions {
                    flex-direction: column;
                }

                .form-actions button {
                    width: 100%;
                }

                .tabs {
                    flex-direction: column;
                }

                .tab-button {
                    width: 100%;
                    justify-content: center;
                }
            }

            @@media(max - width: 480px) {
                    .table-container {
                        font-size: 0.9rem;
                    }

                    .tab-button {
                        padding: 1rem;
                    }
                }

                /* Animation */
                @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .section-content.active {
            animation: fadeIn 0.3s ease-out;
        }
    </style>

    <script>
        // -------------------------------------------
        // 1) TABBED NAVIGATION & UI
        // -------------------------------------------
        function switchTab(tabId) {
            const tabs = document.querySelectorAll(".tab-button");
            const contents = document.querySelectorAll(".tab-content");

            // Remove 'active' from all tabs and contents
            tabs.forEach(t => t.classList.remove("active"));
            contents.forEach(c => c.classList.remove("active"));

            // Activate the target tab button
            const targetTabBtn = document.querySelector(`[data-tab="${tabId}"]`);
            if (targetTabBtn) targetTabBtn.classList.add("active");

            // Activate the target tab content
            const targetContent = document.getElementById(tabId);
            if (targetContent) targetContent.classList.add("active");
        }

        // Called when "Asset List" tab is clicked to load assets
        async function loadAssetList() {
            try {
                const response = await fetch('/api/fullData/getAll');
                if (response.ok) {
                    const assets = await response.json();
                    const tbody = document.getElementById("assetTableBody");
                    tbody.innerHTML = ""; // Clear existing rows

                    assets.forEach(asset => {
                        const tr = document.createElement("tr");
                        tr.innerHTML = `
                            <td>${asset.assetID || asset.AssetID}</td>
                            <td>${asset.assetName || asset.AssetName}</td>
                            <td>${asset.categoryName || asset.CategoryName || "N/A"}</td>
                            <td>${asset.status || asset.Status}</td>
                            <td>${asset.location || asset.Location || "N/A"}</td>
                            <td>
                                <button class="btn-secondary">Edit</button>
                                <button class="btn-danger">Delete</button>
                            </td>
                        `;
                        tbody.appendChild(tr);
                    });
                } else {
                    console.error("Failed to load asset list");
                }
            } catch (error) {
                console.error("Error loading asset list", error);
            }
        }

        // Search Filter
        function filterAssetTable() {
            const searchValue = document.getElementById("searchAsset").value.toLowerCase();
            const rows = document.querySelectorAll("#assetTableBody tr");

            rows.forEach(row => {
                if (row.innerText.toLowerCase().includes(searchValue)) {
                    row.style.display = "";
                } else {
                    row.style.display = "none";
                }
            });
        }

        document.addEventListener("DOMContentLoaded", function () {
            // Attach search filter
            const searchInput = document.getElementById("searchAsset");
            if (searchInput) {
                searchInput.addEventListener("input", filterAssetTable);
            }

            // Show modal on page load
            document.getElementById("deviceModal").style.display = "block";

            // Tab Buttons
            const tabButtons = document.querySelectorAll(".tab-button");
            tabButtons.forEach(btn => {
                btn.addEventListener("click", () => {
                    switchTab(btn.dataset.tab);
                    if (btn.dataset.tab === "assetList") {
                        // Load the asset list whenever we switch to the "assetList" tab
                        loadAssetList();
                    }
                });
            });

            // If the active tab is assetList, load assets immediately
            const activeTab = document.querySelector(".tab-button.active");
            if (activeTab && activeTab.dataset.tab === "assetList") {
                loadAssetList();
            }

            // Close modal button
            document.getElementById("closeDeviceModal").onclick = () => {
                window.location.href = "/Home/Landing";
            };

            // Fill Sample Data button
            const fillBtn = document.getElementById("fillSampleDataBtn");
            fillBtn.addEventListener("click", function () {
                const uniqueSuffix = Date.now();

                // Category
                document.getElementById("categoryName").value = "Desktop " + uniqueSuffix;

                // Vendor
                document.getElementById("vendorName").value = "HP Inc. " + uniqueSuffix;
                document.getElementById("vendorType").value = "Supplier";

                // Location
                document.getElementById("country").value = "USA";
                document.getElementById("state").value = "New York";
                document.getElementById("city").value = "New York";
                document.getElementById("address").value = "4321 Broadway Ave " + uniqueSuffix;
                document.getElementById("zipCode").value = "10018";
                document.getElementById("locationType").value = 2;

                // Asset
                document.getElementById("companyName").value = "XYZ Solutions " + uniqueSuffix;
                document.getElementById("assetName").value = "Office Desktop " + uniqueSuffix;
                document.getElementById("assetTag").value = "OD-" + uniqueSuffix;
                document.getElementById("model").value = "EliteDesk";
                document.getElementById("modelNo").value = "800";
                document.getElementById("serialNumber").value = "SN654321" + uniqueSuffix;
                document.getElementById("purchasedDate").value = "2022-05-20";
                document.getElementById("cost").value = "850.75";
                document.getElementById("eol").value = "2026-05-20";
                document.getElementById("orderNumber").value = "ORD4321" + uniqueSuffix;
                document.getElementById("status").value = "Available";
                document.getElementById("warrantyPeriod").value = "36";
                document.getElementById("warrantyExpires").value = "2025-05-20";
                document.getElementById("currentValue").value = "600.00";
                document.getElementById("fullyDepreciated").checked = false;
                document.getElementById("lastAudit").value = "2023-08-15";
                document.getElementById("nextAuditDate").value = "2024-08-15";
                document.getElementById("notes").value = "Recently serviced.";
            });

            // Form submission logic
            const fullDataForm = document.getElementById("fullDataForm");
            fullDataForm.addEventListener("submit", async function (e) {
                e.preventDefault();

                // Collect Category Data
                const categoryData = {
                    CategoryName: document.getElementById("categoryName").value.trim()
                };

                // Collect Vendor Data
                const vendorData = {
                    VendorName: document.getElementById("vendorName").value.trim(),
                    VendorType: document.getElementById("vendorType").value.trim()
                };

                // Collect Location Data
                const locationData = {
                    Country: document.getElementById("country").value.trim(),
                    State: document.getElementById("state").value.trim(),
                    City: document.getElementById("city").value.trim(),
                    Address: document.getElementById("address").value.trim(),
                    ZipCode: document.getElementById("zipCode").value.trim(),
                    LocationType: document.getElementById("locationType").value.trim()
                };

                // Collect Asset Data
                const assetData = {
                    CompanyName: document.getElementById("companyName").value.trim(),
                    AssetName: document.getElementById("assetName").value.trim(),
                    AssetTag: document.getElementById("assetTag").value.trim(),
                    Model: document.getElementById("model").value.trim(),
                    ModelNo: document.getElementById("modelNo").value.trim(),
                    SerialNumber: document.getElementById("serialNumber").value.trim(),
                    PurchasedDate: document.getElementById("purchasedDate").value,
                    Cost: document.getElementById("cost").value,
                    EOL: document.getElementById("eol").value,
                    OrderNumber: document.getElementById("orderNumber").value.trim(),
                    Status: document.getElementById("status").value,
                    WarrantyPeriod: document.getElementById("warrantyPeriod").value,
                    WarrantyExpires: document.getElementById("warrantyExpires").value,
                    CurrentValue: document.getElementById("currentValue").value,
                    FullyDepreciated: document.getElementById("fullyDepreciated").checked,
                    LastAudit: document.getElementById("lastAudit").value,
                    NextAuditDate: document.getElementById("nextAuditDate").value,
                    Notes: document.getElementById("notes").value.trim()
                };

                // Combine everything for the /api/fullData/add endpoint
                const combinedData = {
                    category: categoryData,
                    vendor: vendorData,
                    location: locationData,
                    asset: assetData
                };

                try {
                    const response = await fetch('/api/fullData/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(combinedData)
                    });

                    if (response.ok) {
                        alert('Data added successfully!');
                        fullDataForm.reset();
                        // Load updated asset list and switch to the "Asset List" tab
                        loadAssetList();
                        switchTab('assetList');
                    } else {
                        alert('Failed to add data.');
                    }
                } catch (error) {
                    console.error('Error adding data:', error);
                    alert('An error occurred while adding the data.');
                }
            });

            const bulkUploadForm = document.getElementById("bulkUploadForm");
            const fileInput = document.querySelector('input[name="Files"]');

            bulkUploadForm.addEventListener("submit", async function (e) {
                // Ensure a file is selected
                if (fileInput.files.length === 0) {
                    alert("Please select a file to upload.");
                    e.preventDefault();
                    return;
                }

                // Since only one file is allowed, pick the first file
                const file = fileInput.files[0];

                // Define allowed MIME types for Excel files
                const allowedTypes = [
                    "application/vnd.ms-excel", // XLS
                    "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" // XLSX
                ];

                // Define allowed file extensions (case-insensitive)
                const allowedExtensions = /\.(xls|xlsx)$/i;

                // Validate the file's MIME type if available
                if (file.type && !allowedTypes.includes(file.type)) {
                    alert(`Invalid file type for ${file.name}. Please upload an Excel file (.xls or .xlsx).`);
                    e.preventDefault();
                    return;
                }

                // Fallback: Validate using the file extension in case the MIME type is unreliable
                if (!allowedExtensions.test(file.name)) {
                    alert(`Invalid file extension for ${file.name}. Please upload an Excel file (.xls or .xlsx).`);
                    e.preventDefault();
                    return;
                }

                try {

                    // Create FormData to send the file
                    const formData = new FormData();
                    formData.append('File', file);

                    const response = await fetch('/api/fullData/BulkUploadAssetDetails', {
                        method: 'POST',
                        body: formData
                    });

                    // Parse the JSON response
                    const data = await response.json();

                    if (response.ok) {
                        alert('Data added successfully! ' + data.message);
                        bulkUploadForm.reset();
                        // Load updated asset list and switch to the "Asset List" tab
                        loadAssetList();
                        switchTab('assetList');
                    }
                    else {
                        alert('Failed to add data. ' + data.message);
                    }
                }
                catch(error) {
                    console.log('Error completing bulk upload data: ' + error);
                    alert('An error occurred while completing bulk upload data. Please try again.');
                }
            });
        });
    </script>
</body>
</html>

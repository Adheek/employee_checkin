@@keyframes placeholderShimmer{0%{background-position-x:100%}to{background-position-x:0}}
</style>
</head>
<body>
    <!-- Scanner Options Modal -->
    <div id="scannerOptionsModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2>Choose an Option</h2>
                <button class="close-modal" onclick="closeModal('scannerOptionsModal')">&times;</button>
            </div>
            <div class="modal-body">
                <button id="liveScanOption"> 
                    <i class="fas fa-camera"></i> Scan QR Code
                </button>
                <button id="uploadOption"> 
                    <i class="fas fa-upload"></i> Upload QR Image
                </button>
            </div>
        </div>
    </div>

    <!-- Upload Modal -->
    <div id="uploadModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2><i class="fas fa-upload"></i> Upload QR Image</h2>
                <button class="close-modal" onclick="closeModal('uploadModal')">&times;</button>
            </div>
            <div class="modal-body">
                <input type="file" id="qrFileInput" accept="image/*">
                <button id="uploadSubmitBtn" class="action-btn scan-new" style="margin-top:1rem;">Submit Image</button>
            </div>
        </div>
    </div>

    <!-- Live Scanner Modal -->
    <div id="qrModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2><i class="fas fa-qrcode"></i> Scan QR Code</h2>
                <button class="close-modal" onclick="closeModal('qrModal')">&times;</button>
            </div>
            <div class="modal-body">
                <div id="reader" style="width: 100%;"></div>
                <div id="scannerMessage">Initializing camera...</div>
            </div>
        </div>
    </div>

    <main class="content">
        <div class="details-container">
            <!-- Header -->
            <div class="header">
                <button class="back-btn" onclick="history.back()">
                    <i class="fas fa-arrow-left"></i> Back
                </button>
                <h1>Scan Details</h1>
            </div>

            <!-- Status -->
            <div id="currentStatus" class="status ready">Ready to Check In</div>

            <!-- Scan Info -->
            <div class="scan-info">
                <!-- Scanned Data Card -->
                <div class="info-card">
                    <div class="card-header">
                        <i class="fas fa-qrcode"></i>
                        <h2>Scanned Data</h2>
                        <div class="scan-data-display">@ViewBag.ScannedData</div>
                    </div>
                    <div class="card-body">
                        <!-- Decoded text will be displayed here -->
                        <div id="scannedContent" class="scanned-data-list"></div>
                    </div>
                </div>

                <!-- Details Grid -->
                <div class="details-grid">
                    <!-- Check In Time -->
                    <div class="info-card">
                        <div class="card-header">
                            <i class="fas fa-clock"></i>
                            <h2>Check In Time</h2>
                        </div>
                        <div class="card-body">
                            <p id="timeDisplay">Not checked in</p>
                        </div>
                    </div>

                    <!-- Check Out Time -->
                    <div class="info-card">
                        <div class="card-header">
                            <i class="fas fa-clock"></i>
                            <h2>Check Out Time</h2>
                        </div>
                        <div class="card-body">
                            <p id="checkOutTimeDisplay">Not checked out</p>
                        </div>
                    </div>

                    <!-- Duration -->
                    <div class="info-card">
                        <div class="card-header">
                            <i class="fas fa-hourglass-half"></i>
                            <h2>Duration</h2>
                        </div>
                        <div class="card-body">
                            <p id="duration">Not checked in</p>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="action-buttons">
                    <button id="checkInBtn" class="action-btn check-in" disabled>
                        <i class="fas fa-sign-in-alt"></i> Check In
                    </button>
                    <button id="checkOutBtn" class="action-btn check-out" disabled>
                        <i class="fas fa-sign-out-alt"></i> Check Out
                    </button>
                    <button id="reportMismatchBtn" class="action-btn check-out">
                        <i class="fas fa-exclamation-triangle"></i> Report Mismatch
                    </button>
                    <button id="scanNewBtn" class="action-btn scan-new">
                        <i class="fas fa-qrcode"></i> Scan Another Device
                    </button>
                </div>
            </div>
        </div>
    </main>

    <script>
        /********************************************************************
         * Global Variables for Decoded Values
         ********************************************************************/
        let currentAssetId = null;
        let currentEmployeeId = null;
        let currentEmployeeName = null;
        let currentStatus = null;

        /********************************************************************
         * Modal Open/Close Functions
         ********************************************************************/
        function openModal(modalId) {
            document.getElementById(modalId).style.display = "block";
        }
        function closeModal(modalId) {
            document.getElementById(modalId).style.display = "none";
        }
        // Close modal if click outside modal-content
        window.addEventListener("click", function(event) {
            document.querySelectorAll(".modal").forEach(modal => {
                if (event.target === modal) {
                    modal.style.display = "none";
                }
            });
        });

        /********************************************************************
         * QR Data Parsing Utility
         ********************************************************************/
        function parseKeyValueString(input) {
            const dict = {};
            const pairs = input.split(";").map(p => p.trim()).filter(Boolean);
            pairs.forEach(pair => {
                const [key, value] = pair.split("=");
                if (key && value) {
                    dict[key.trim()] = value.trim();
                }
            });
            return dict;
        }

        /********************************************************************
         * Live Scanner Setup using Html5Qrcode
         ********************************************************************/
        function startScanner() {
            const html5QrcodeScanner = new Html5QrcodeScanner(
                "reader",
                { fps: 10, qrbox: 250 },
                false
            );

            function onScanSuccess(decodedText, decodedResult) {
                const data = parseKeyValueString(decodedText);
                currentAssetId = data.AssetId || null;
                currentEmployeeId = data.EmployeeId ? parseInt(data.EmployeeId) : null;
                currentEmployeeName = data.EmployeeName || null;
                currentStatus = data.Status || null;

                document.getElementById("scannedContent").innerText = decodedText;
                const checkInBtn = document.getElementById("checkInBtn");
                if (currentAssetId && currentEmployeeId && currentEmployeeName) {
                    checkInBtn.disabled = false;
                }
                closeModal("qrModal");
                html5QrcodeScanner.clear();
            }

            function onScanError(errorMessage) {
                // Optionally log or ignore scan errors
            }

            html5QrcodeScanner.render(onScanSuccess, onScanError);
        }

        /********************************************************************
         * Upload QR Image Functionality using jsQR
         ********************************************************************/
        function uploadQr() {
            const input = document.getElementById("qrFileInput");
            if (!input.files || input.files.length === 0) {
                alert("Please select a QR image to upload.");
                return;
            }
            const file = input.files[0];
            const reader = new FileReader();
            reader.onload = async function(e) {
                const imageDataUrl = e.target.result;
                try {
                    const decodedText = await decodeQrFromImage(imageDataUrl);
                    if (decodedText) {
                        const data = parseKeyValueString(decodedText);
                        currentAssetId = data.AssetId || null;
                        currentEmployeeId = data.EmployeeId ? parseInt(data.EmployeeId) : null;
                        currentEmployeeName = data.EmployeeName || null;
                        currentStatus = data.Status || null;
                        document.getElementById("scannedContent").innerText = decodedText;
                        const checkInBtn = document.getElementById("checkInBtn");
                        if (currentAssetId && currentEmployeeId && currentEmployeeName) {
                            checkInBtn.disabled = false;
                        }
                        closeModal("uploadModal");
                    } else {
                        alert("Unable to decode QR code from the image.");
                    }
                } catch (error) {
                    console.error("Error decoding QR image:", error);
                    alert("Error decoding QR image: " + error.message);
                }
            };
            reader.readAsDataURL(file);
        }
        async function decodeQrFromImage(imageDataUrl) {
            return new Promise((resolve, reject) => {
                const image = new Image();
                image.onload = function() {
                    const canvas = document.createElement("canvas");
                    canvas.width = image.width;
                    canvas.height = image.height;
                    const context = canvas.getContext("2d");
                    context.drawImage(image, 0, 0, canvas.width, canvas.height);
                    const imageData = context.getImageData(0, 0, canvas.width, canvas.height);
                    const code = jsQR(imageData.data, canvas.width, canvas.height);
                    if (code) {
                        resolve(code.data);
                    } else {
                        reject(new Error("QR code not found in the image."));
                    }
                };
                image.onerror = function() {
                    reject(new Error("Could not load image for QR decoding."));
                };
                image.src = imageDataUrl;
            });
        }

        /********************************************************************
         * Button Event Handlers
         ********************************************************************/
        document.addEventListener("DOMContentLoaded", () => {
            // Open the options modal on page load
            openModal("scannerOptionsModal");
        });
        document.getElementById("liveScanOption").addEventListener("click", () => {
            closeModal("scannerOptionsModal");
            openModal("qrModal");
            startScanner();
        });
        document.getElementById("uploadOption").addEventListener("click", () => {
            closeModal("scannerOptionsModal");
            openModal("uploadModal");
        });
        document.getElementById("uploadSubmitBtn").addEventListener("click", uploadQr);

        const checkInBtn = document.getElementById("checkInBtn");
        const checkOutBtn = document.getElementById("checkOutBtn");
        const reportMismatchBtn = document.getElementById("reportMismatchBtn");
        const scanNewBtn = document.getElementById("scanNewBtn");

        if (checkInBtn) {
            checkInBtn.addEventListener("click", handleCheckIn);
        }
        if (checkOutBtn) {
            checkOutBtn.addEventListener("click", handleCheckOut);
        }
        if (reportMismatchBtn) {
            reportMismatchBtn.addEventListener("click", () => openModal("mismatchModal"));
        }
        if (scanNewBtn) {
            scanNewBtn.addEventListener("click", () => {
                openModal("scannerOptionsModal");
            });
        }

        async function handleCheckIn() {
            if (!currentAssetId || !currentEmployeeId || !currentEmployeeName) {
                alert("No valid asset/employee data found from QR scan.");
                return;
            }
            try {
                const response = await fetch('/api/ScanDetails/CheckIn', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        assetId: currentAssetId,
                        employeeId: currentEmployeeId,
                        employeeName: currentEmployeeName
                    })
                });
                const result = await response.json();
                if (response.ok && result.success) {
                    const now = new Date().toLocaleString();
                    document.getElementById("timeDisplay").innerText = now;
                    document.getElementById("currentStatus").innerText = "Checked In";
                    document.getElementById("currentStatus").classList.remove("ready");
                    document.getElementById("currentStatus").style.backgroundColor = "#007bff";
                    checkInBtn.disabled = true;
                    checkOutBtn.disabled = false;
                } else {
                    alert("Check-in failed: " + (result.message || "Unknown error"));
                }
            } catch (err) {
                console.error("CheckIn error:", err);
                alert("Error during check-in. See console for details.");
            }
        }
        async function handleCheckOut() {
            if (!currentAssetId || !currentEmployeeId || !currentEmployeeName) {
                alert("No valid asset/employee data found from QR scan.");
                return;
            }
            try {
                const response = await fetch('/api/ScanDetails/CheckOut', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        assetId: currentAssetId,
                        employeeId: currentEmployeeId,
                        employeeName: currentEmployeeName
                    })
                });
                const result = await response.json();
                if (response.ok && result.success) {
                    const now = new Date().toLocaleString();
                    document.getElementById("checkOutTimeDisplay").innerText = now;
                    document.getElementById("currentStatus").innerText = "Checked Out";
                    document.getElementById("currentStatus").style.backgroundColor = "#dc3545";
                    checkOutBtn.disabled = true;
                    const checkInTime = document.getElementById("timeDisplay").innerText;
                    document.getElementById("duration").innerText = `From ${checkInTime} to ${now}`;
                } else {
                    alert("Check-out failed: " + (result.message || "Unknown error"));
                }
            } catch (err) {
                console.error("CheckOut error:", err);
                alert("Error during check-out. See console for details.");
            }
        }
    </script>
</body>
</html>

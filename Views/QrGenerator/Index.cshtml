@{
    ViewData["Title"] = "QR Generator";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QR Generator</title>
  <link rel="stylesheet" href="~/css/default.css">
  <link rel="stylesheet" href="~/css/default1.css">
  <link rel="stylesheet" href="~/css/default2.css"> 
  <link rel="stylesheet" href="~/css/site.css">
  <link rel="stylesheet" href="~/css/style.css">   
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <!-- QRCode.js library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
  <style>
    /* Modal styling */
    .modal {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(244, 241, 234, 0.95);
      z-index: 1000;
      padding: 0 1rem;
    }
   
    /* Overall container responsiveness */
    .qr-generator-content {
      max-width: 700px; /* Keep the form from stretching too wide on desktop */
      margin: 0 auto;
      padding: 2rem;
    }

    /* Ensure the QR form rows wrap properly */
    .qr-form .form-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }

    /* Make the modal/container narrower on smaller screens */
    @@media (max-width: 768px) {
      .qr-generator-content {
        width: 90%;
        padding: 1rem;
      }
      .qr-form .form-row {
        grid-template-columns: 1fr;
        gap: 1rem;
      }
      .qr-actions {
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
      }
      .qr-action-btn {
        width: 100%;
        justify-content: center;
      }
      .qr-container {
        padding: 1rem;
        margin: 1rem 0;
      }
      .qr-preview {
        width: 100%;
        max-width: 250px;
        height: auto;
        margin: 0 auto;
      }
    }
    @@media (max-width: 480px) {
      .qr-tabs {
        flex-direction: column;
        gap: 0.5rem;
      }
      .qr-generator-content {
        padding: 0.75rem;
      }
    }
    
    /* Styles for multiple QR preview items */
    .multi-qr-preview {
      margin-top: 1rem;
    }
    .qr-item {
      display: inline-block;
      margin: 10px;
      text-align: center;
    }
  </style>
</head>
<body>
  <!-- QR Generator Modal -->
  <div id="qrGeneratorModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2><i class="fas fa-qrcode"></i> QR Code Generator</h2>
        <button class="close-btn" id="closeQrModal">&times;</button>
      </div>

      <!-- Tab Buttons -->
      <div class="tabs">
        <button class="tab-button active" data-tab="singleQR">Single QR Generator</button>
        <button class="tab-button" data-tab="multipleQR">Multiple QR Generator</button>
      </div>

      <!-- Single QR Generator Tab -->
      <div id="singleQR" class="tab-content active">
        <div class="form-section">
          <form id="qrGeneratorForm">
            <div class="form-row">
              <div class="form-group">
                <label for="qrAssetId">Asset ID*</label>
                <input type="text" id="qrAssetId" name="qrAssetId" required>
              </div>
              <div class="form-group">
                <label for="qrAssetName">Asset Name*</label>
                <input type="text" id="qrAssetName" name="qrAssetName" required>
              </div>
              <div class="form-group">
                <label for="qrEmployeeId">Employee ID*</label>
                <input type="text" id="qrEmployeeId" name="qrEmployeeId" required>
              </div>
            </div>

            <div class="qr-container">
              <div id="qrPreview" class="qr-preview"></div>
              <div class="qr-actions">
                <!-- We auto-generate on input; Download/Print just re-check. -->
                <button type="button" class="qr-action-btn download" id="downloadQr">
                  <i class="fas fa-download"></i> Download
                </button>
                <button type="button" class="qr-action-btn print" id="printQr">
                  <i class="fas fa-print"></i> Print
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- Multiple QR Generator Tab -->
      <div id="multipleQR" class="tab-content">
        <div class="table-actions">
          <div class="bulk-actions">
            <button type="button" class="action-btn download" id="downloadSelected">
              <i class="fas fa-download"></i> Download Selected
            </button>
            <button type="button" class="action-btn print" id="printSelected">
              <i class="fas fa-print"></i> Print Selected
            </button>
          </div>
        </div>
        <div class="qr-table-container">
          <table class="qr-table">
            <thead>
              <tr>
                <th width="50px">
                  <input type="checkbox" class="select-all-checkbox" id="selectAll">
                </th>
                <th>Asset ID</th>
                <th>Asset Name</th>
                <th>Status</th>
                <th>Employee ID</th>
              </tr>
            </thead>
            <tbody id="assetTableBody">
              <!-- Populate table rows dynamically -->
            </tbody>
          </table>
        </div>
        
      </div>
    </div>
  </div>

  <!-- JavaScript -->
 <script>
  // ===========================
  // SINGLE QR CODE FUNCTIONS
  // ===========================
  function generateSingleQRCode() {
    const assetId = document.getElementById("qrAssetId").value.trim();
    const assetName = document.getElementById("qrAssetName").value.trim();
    const employeeId = document.getElementById("qrEmployeeId").value.trim();

    const qrPreview = document.getElementById("qrPreview");
    if (!qrPreview) return false;

    // If required fields are missing, clear preview and return
    if (!assetId || !assetName || !employeeId) {
      qrPreview.innerHTML = "";
      return false;
    }

    const qrText = `Asset ID: ${assetId}\nAsset Name: ${assetName}\nEmployee ID: ${employeeId}`;

    // Clear any existing QR
    qrPreview.innerHTML = "";

    // Generate new QR
    new QRCode(qrPreview, {
      text: qrText,
      width: 200,
      height: 200
    });

    return true;
  }

  // ===========================
  // MULTIPLE QR CODE FUNCTIONS
  // ===========================
  // Gathers selected rows and returns an array of asset objects
  function getSelectedAssets() {
    const selected = [];
    const checkboxes = document.querySelectorAll("#assetTableBody input[type='checkbox']:checked");
    checkboxes.forEach(checkbox => {
      const row = checkbox.closest("tr");
      if (!row) return;
      const cells = row.getElementsByTagName("td");
      const assetId = cells[1]?.textContent.trim() || "";
      const assetName = cells[2]?.textContent.trim() || "";
      const status = cells[3]?.textContent.trim() || "";
      const employeeId = cells[4]?.textContent.trim() || "";
      selected.push({ assetId, assetName, status, employeeId });
    });
    return selected;
  }

  // Generates QRs for each selected asset in a hidden container
  function generateHiddenQRCodesForSelected(assets, callback) {
    // Create a hidden container (off-screen)
    const hiddenContainer = document.createElement("div");
    hiddenContainer.style.display = "none";
    document.body.appendChild(hiddenContainer);

    // For each asset, generate a QR code in the hidden container
    assets.forEach(asset => {
      const assetDiv = document.createElement("div");
      hiddenContainer.appendChild(assetDiv);

      const qrText = `Asset ID: ${asset.assetId}\nAsset Name: ${asset.assetName}\nEmployee ID: ${asset.employeeId}\nStatus: ${asset.status}`;

      new QRCode(assetDiv, {
        text: qrText,
        width: 150,
        height: 150
      });
    });

    // Wait a short time so canvases can render
    setTimeout(() => {
      callback(hiddenContainer, assets);
    }, 300); // adjust delay as needed
  }

  // ===========================
  // ON DOMContentLoaded
  // ===========================
  document.addEventListener("DOMContentLoaded", function() {
    // Fetch mapped assets for the table
    fetch('/api/EmployeeAssetMapping/mappedAssets')
      .then(response => {
        if (!response.ok) throw new Error("Network response was not ok: " + response.statusText);
        return response.json();
      })
      .then(data => {
        const tableBody = document.getElementById("assetTableBody");
        data.forEach(asset => {
          const row = document.createElement("tr");

          // Checkbox column
          const checkboxCell = document.createElement("td");
          const checkbox = document.createElement("input");
          checkbox.type = "checkbox";
          checkboxCell.appendChild(checkbox);
          row.appendChild(checkboxCell);

          // Asset ID
          const assetIdCell = document.createElement("td");
          assetIdCell.textContent = asset.assetId;
          row.appendChild(assetIdCell);

          // Asset Name
          const assetNameCell = document.createElement("td");
          assetNameCell.textContent = asset.assetName;
          row.appendChild(assetNameCell);

          // Status
          const statusCell = document.createElement("td");
          statusCell.textContent = asset.status || "N/A";
          row.appendChild(statusCell);

          // Employee ID
          const empCell = document.createElement("td");
          empCell.textContent = asset.employeeId;
          row.appendChild(empCell);

          tableBody.appendChild(row);
        });
      })
      .catch(err => console.error("Error fetching mapped assets:", err));

    // "Select All" checkbox functionality
    const selectAllCheckbox = document.getElementById("selectAll");
    selectAllCheckbox.addEventListener("change", function() {
      const checkboxes = document.querySelectorAll("#assetTableBody input[type='checkbox']");
      checkboxes.forEach(cb => cb.checked = selectAllCheckbox.checked);
    });

    // Close modal button
    document.getElementById("closeQrModal").addEventListener("click", function(){
      window.location.href = "/Home/Landing";
    });

    // Tab switching
    const tabButtons = document.querySelectorAll(".tab-button");
    const tabContents = document.querySelectorAll(".tab-content");
    tabButtons.forEach(button => {
      button.addEventListener("click", function() {
        tabButtons.forEach(btn => btn.classList.remove("active"));
        tabContents.forEach(content => content.classList.remove("active"));
        button.classList.add("active");
        document.getElementById(button.getAttribute("data-tab")).classList.add("active");
      });
    });

    // Auto-generate single QR on input
    ["qrAssetId","qrAssetName","qrEmployeeId"].forEach(id => {
      const field = document.getElementById(id);
      if (field) {
        field.addEventListener("input", () => {
          generateSingleQRCode();
        });
      }
    });

    // =========================
    // SINGLE QR: Download
    // =========================
    document.getElementById("downloadQr").addEventListener("click", function(){
      if (!generateSingleQRCode()) {
        alert("Please fill out Asset ID, Asset Name, and Employee ID before proceeding.");
        return;
      }

      const qrContainer = document.getElementById("qrPreview");
      let canvas = qrContainer.querySelector("canvas");
      if (!canvas) {
        // If rendered as an <img>
        const img = qrContainer.querySelector("img");
        if (img) {
          canvas = document.createElement("canvas");
          canvas.width = img.width;
          canvas.height = img.height;
          const ctx = canvas.getContext("2d");
          ctx.drawImage(img, 0, 0);
        }
      }

      if (canvas) {
        const assetId = document.getElementById("qrAssetId").value.trim();
        const newCanvas = document.createElement("canvas");
        const margin = 10;
        const textHeight = 20;
        newCanvas.width = canvas.width;
        newCanvas.height = canvas.height + margin + textHeight;

        const ctx2 = newCanvas.getContext("2d");
        ctx2.drawImage(canvas, 0, 0);

        ctx2.font = "16px Arial";
        ctx2.fillStyle = "#000";
        const text = `Asset ID: ${assetId}`;
        const textWidth = ctx2.measureText(text).width;
        const xPos = (newCanvas.width - textWidth) / 2;
        const yPos = canvas.height + margin + 15; 
        ctx2.fillText(text, xPos, yPos);

        const dataURL = newCanvas.toDataURL("image/png");
        const link = document.createElement("a");
        link.href = dataURL;
        link.download = `qrcode_${assetId}.png`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      } else {
        alert("Unable to download QR code. Please try again.");
      }
    });

    // =========================
    // SINGLE QR: Print
    // =========================
    document.getElementById("printQr").addEventListener("click", function(){
      if (!generateSingleQRCode()) {
        alert("Please fill out Asset ID, Asset Name, and Employee ID before proceeding.");
        return;
      }

      const canvas = document.querySelector("#qrPreview canvas");
      if (!canvas) {
        alert("No QR code found to print.");
        return;
      }

      const dataURL = canvas.toDataURL("image/png");
      const assetId = document.getElementById("qrAssetId").value.trim();
      const printContainer = document.createElement("div");

      const img = new Image();
      img.src = dataURL;
      img.style.display = "block";
      img.style.margin = "0 auto";
      printContainer.appendChild(img);

      const assetIdElement = document.createElement("p");
      assetIdElement.style.textAlign = "center";
      assetIdElement.textContent = "Asset ID: " + assetId;
      printContainer.appendChild(assetIdElement);

      const originalContent = document.body.innerHTML;
      document.body.innerHTML = printContainer.innerHTML;
      window.print();
      document.body.innerHTML = originalContent;
    });

    // =========================
    // MULTIPLE QR: Download
    // =========================
    document.getElementById("downloadSelected").addEventListener("click", function(){
      const selectedAssets = getSelectedAssets();
      if (!selectedAssets.length) {
        alert("Please select at least one asset to download.");
        return;
      }

      // Generate QRs in a hidden container
      generateHiddenQRCodesForSelected(selectedAssets, (hiddenContainer, assets) => {
        // Now each asset has a <canvas> in hiddenContainer
        const divs = hiddenContainer.querySelectorAll("div");
        divs.forEach((div, index) => {
          const canvas = div.querySelector("canvas");
          if (!canvas) return;
          const dataURL = canvas.toDataURL("image/png");
          const link = document.createElement("a");
          link.href = dataURL;
          link.download = `qrcode_${index+1}.png`;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        });
        // Remove the hidden container
        document.body.removeChild(hiddenContainer);
      });
    });

    // =========================
    // MULTIPLE QR: Print
    // =========================
    document.getElementById("printSelected").addEventListener("click", function(){
      const selectedAssets = getSelectedAssets();
      if (!selectedAssets.length) {
        alert("Please select at least one asset to print.");
        return;
      }

      // Generate QRs in a hidden container
      generateHiddenQRCodesForSelected(selectedAssets, (hiddenContainer, assets) => {
        // Build a print container with <img> copies
        const printContainer = document.createElement("div");
        const divs = hiddenContainer.querySelectorAll("div");

        divs.forEach((div, index) => {
          const canvas = div.querySelector("canvas");
          if (!canvas) return;

          const dataURL = canvas.toDataURL("image/png");
          const itemDiv = document.createElement("div");
          itemDiv.style.textAlign = "center";
          itemDiv.style.marginBottom = "20px";

          const img = new Image();
          img.src = dataURL;
          itemDiv.appendChild(img);

          // Add label text
          const labelP = document.createElement("p");
          labelP.textContent = "Asset ID: " + assets[index].assetId;
          itemDiv.appendChild(labelP);

          printContainer.appendChild(itemDiv);
        });

        // Temporarily replace the page content
        const originalContent = document.body.innerHTML;
        document.body.innerHTML = "";
        document.body.appendChild(printContainer);

        window.print();

        // Restore
        document.body.innerHTML = originalContent;
        document.body.removeChild(hiddenContainer);
      });
    });
  });
</script>


</body>
</html>

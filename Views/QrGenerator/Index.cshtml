@{
    ViewData["Title"] = "QR Generator";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>QR Generator</title>
  <link rel="stylesheet" href="~/css/default.css">
  <link rel="stylesheet" href="~/css/default1.css">
  <link rel="stylesheet" href="~/css/default2.css"> 
  <link rel="stylesheet" href="~/css/site.css">
  <link rel="stylesheet" href="~/css/style.css">   
  <!-- Google Fonts -->
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
  <!-- Font Awesome -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
  <!-- QRCode.js library -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>

  <style>
    .qr-preview canvas,
    .qr-preview img {
      width: 50mm !important;
      height: 25mm !important;
    }
    .modal { display: block; position: fixed; top:0; left:0; width:100%; height:100%; background:rgba(244,241,234,0.95); z-index:1000; padding:0 1rem; }
    .qr-generator-content { max-width:700px; margin:0 auto; padding:2rem; }
    .qr-form .form-row { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:1.5rem; margin-bottom:1.5rem; }
    @@media (max-width:768px) {
      .qr-generator-content { width:90%; padding:1rem; }
      .qr-form .form-row { grid-template-columns:1fr; gap:1rem; }
      .qr-actions { flex-direction:column; gap:0.75rem; width:100%; }
      .qr-action-btn { width:100%; justify-content:center; }
      .qr-container { padding:1rem; margin:1rem 0; }
      .qr-preview { width:100%; max-width:250px; height:auto; margin:0 auto; }
    }
    @@media (max-width:480px) {
      .qr-tabs { flex-direction:column; gap:0.5rem; }
      .qr-generator-content { padding:0.75rem; }
    }
    .multi-qr-preview { margin-top:1rem; }
    .qr-item { display:inline-block; margin:10px; text-align:center; }
  </style>
</head>
<body>
  <div id="qrGeneratorModal" class="modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2><i class="fas fa-qrcode"></i> QR Code Generator</h2>
        <button class="close-btn" id="closeQrModal">&times;</button>
      </div>

      <div class="tabs">
        <button class="tab-button active" data-tab="singleQR">Single QR Generator</button>
        <button class="tab-button" data-tab="multipleQR">Multiple QR Generator</button>
      </div>

      <!-- SINGLE QR GENERATOR -->
      <div id="singleQR" class="tab-content active">
        <div class="form-section qr-form">
          <form id="qrGeneratorForm">
            <div class="form-row">
              <div class="form-group">
                <label for="qrAssetId">Asset ID*</label>
                <input type="text" id="qrAssetId" name="qrAssetId" required>
              </div>
              <div class="form-group">
                <label for="qrAssetName">Asset Name*</label>
                <input type="text" id="qrAssetName" name="qrAssetName" required>
              </div>
              <div class="form-group">
                <label for="qrEmployeeId">Employee ID*</label>
                <input type="text" id="qrEmployeeId" name="qrEmployeeId" required>
              </div>
            </div>

            <div class="qr-container">
              <div id="qrPreview" class="qr-preview"></div>
              <div class="qr-actions">
                <button type="button" class="qr-action-btn download" id="downloadQr">
                  <i class="fas fa-download"></i> Download
                </button>
                <button type="button" class="qr-action-btn print" id="printQr">
                  <i class="fas fa-print"></i> Print
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- MULTIPLE QR GENERATOR -->
      <div id="multipleQR" class="tab-content">
        <div class="table-actions">
          <div class="bulk-actions">
            <button type="button" class="action-btn download" id="downloadSelected">
              <i class="fas fa-download"></i> Download Selected
            </button>
            <button type="button" class="action-btn print" id="printSelected">
              <i class="fas fa-print"></i> Print Selected
            </button>
          </div>
        </div>
        <div class="qr-table-container">
          <table class="qr-table">
            <thead>
              <tr>
                <th width="50px"><input type="checkbox" id="selectAll"></th>
                <th>Asset ID</th>
                <th>Asset Name</th>
                <th>Employee ID</th>
                <th>Employee Name</th>
                <th>Location</th>
              </tr>
            </thead>
            <tbody id="assetTableBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

<script>
  // ===========================
  // SINGLE QR CODE FUNCTIONS
  // ===========================
  function generateSingleQRCode() {
    const id      = document.getElementById("qrAssetId").value.trim();
    const name    = document.getElementById("qrAssetName").value.trim();
    const emp     = document.getElementById("qrEmployeeId").value.trim();
    const preview = document.getElementById("qrPreview");
    if (!id || !name || !emp) {
      preview.innerHTML = "";
      return false;
    }
    const text =
      `Asset ID: ${id}\n` +
      `Asset Name: ${name}\n` +
      `Employee ID: ${emp}`;
    preview.innerHTML = "";
    new QRCode(preview, { text, width: 200, height: 200 });
    return true;
  }

  // ===========================
  // MULTIPLE QR CODE HELPERS
  // ===========================
  function getSelectedAssets() {
    const sel = [];
    document.querySelectorAll("#assetTableBody input[type='checkbox']:checked")
      .forEach(cb => {
        const cells = cb.closest("tr").getElementsByTagName("td");
        sel.push({
          assetId:      cells[1].textContent.trim(),
          assetName:    cells[2].textContent.trim(),
          employeeId:   cells[3].textContent.trim(),
          employeeName: cells[4].textContent.trim(),
          location:     cells[5].textContent.trim()
        });
      });
    return sel;
  }

  function generateHiddenQRCodesForSelected(assets, cb) {
    const container = document.createElement("div");
    container.style.display = "none";
    document.body.appendChild(container);

    assets.forEach(a => {
      const d = document.createElement("div");
      container.appendChild(d);
      const text =
        `Asset ID: ${a.assetId}\n` +
        `Asset Name: ${a.assetName}\n` +
        `Employee ID: ${a.employeeId}\n` +
        `Employee Name: ${a.employeeName}\n` +
        `Location: ${a.location}`;
      new QRCode(d, { text, width: 150, height: 150 });
    });

    setTimeout(() => cb(container, assets), 300);
  }

  async function loadAssetsTable() {
    try {
      const res  = await fetch('/api/fullData/getAll');
      if (!res.ok) throw new Error(res.statusText);
      const data = await res.json();
      const tbody = document.getElementById("assetTableBody");
      tbody.innerHTML = "";
      data.forEach(a => {
        const tr = document.createElement("tr");
        tr.innerHTML =
          `<td><input type="checkbox"></td>
           <td>${a.assetID}</td>
           <td>${a.assetName}</td>
           <td>${a.employeeId ?? ''}</td>
           <td>${a.employeeName ?? ''}</td>
           <td>${a.location ?? ''}</td>`;
        tbody.appendChild(tr);
      });
    } catch (e) {
      console.error("Could not load assets:", e);
      alert("Could not load assets.");
    }
  }

  // ===========================
  // DOM CONTENT LOADED
  // ===========================
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Populate the table
    loadAssetsTable();

    // 2. Single‑QR: auto‑generate on input
    ["qrAssetId","qrAssetName","qrEmployeeId"].forEach(id => {
      document.getElementById(id)
        .addEventListener("input", generateSingleQRCode);
    });

    // 3. Single‑QR: Download
    document.getElementById("downloadQr").addEventListener("click", () => {
      if (!generateSingleQRCode()) {
        return alert("Fill out Asset ID, Asset Name, and Employee ID.");
      }
      const container = document.getElementById("qrPreview");
      let canvas = container.querySelector("canvas");
      if (!canvas) {
        const img = container.querySelector("img");
        if (img) {
          canvas = document.createElement("canvas");
          canvas.width  = img.width;
          canvas.height = img.height;
          canvas.getContext("2d").drawImage(img, 0, 0);
        }
      }
      if (!canvas) return alert("No QR to download.");
      const link = document.createElement("a");
      link.href     = canvas.toDataURL("image/png");
      link.download = `qrcode_${document.getElementById("qrAssetId").value}.png`;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    // 4. Single‑QR: Print
    document.getElementById("printQr").addEventListener("click", () => {
      if (!generateSingleQRCode()) {
        return alert("Fill out Asset ID, Asset Name, and Employee ID.");
      }
      const canvas = document.querySelector("#qrPreview canvas");
      if (!canvas) return alert("No QR to print.");
      const dataURL = canvas.toDataURL("image/png");
      const img = new Image();
      img.src           = dataURL;
      img.style.display = "block";
      img.style.margin  = "0 auto";
      img.style.width   = "50mm";
      img.style.height  = "35mm";

      const original = document.body.innerHTML;
      document.body.innerHTML = `<div style="text-align:center">${img.outerHTML}</div>`;
      window.print();
      document.body.innerHTML = original;
    });

    // 5. Select‑All checkbox
    document.getElementById("selectAll").addEventListener("change", function() {
      document.querySelectorAll("#assetTableBody input[type='checkbox']")
        .forEach(cb => cb.checked = this.checked);
    });

    // 6. Tab switching
    document.querySelectorAll(".tab-button").forEach(btn => {
      btn.addEventListener("click", function() {
        document.querySelectorAll(".tab-button").forEach(b => b.classList.remove("active"));
        document.querySelectorAll(".tab-content").forEach(c => c.classList.remove("active"));
        this.classList.add("active");
        document.getElementById(this.dataset.tab).classList.add("active");
      });
    });

    // 7. Multiple‑QR: Download Selected
    document.getElementById("downloadSelected").addEventListener("click", () => {
      const sel = getSelectedAssets();
      if (!sel.length) return alert("Select at least one asset.");
      generateHiddenQRCodesForSelected(sel, (hc) => {
        hc.querySelectorAll("div").forEach((div, i) => {
          const c = div.querySelector("canvas");
          if (!c) return;
          const link = document.createElement("a");
          link.href     = c.toDataURL("image/png");
          link.download = `qrcode_${i+1}.png`;
          document.body.appendChild(link);
          link.click();
          document.body.removeChild(link);
        });
        document.body.removeChild(hc);
      });
    });

    // 8. Multiple‑QR: Print Selected (only Asset ID caption)
    document.getElementById("printSelected").addEventListener("click", () => {
      const sel = getSelectedAssets();
      if (!sel.length) return alert("Select at least one asset.");
      generateHiddenQRCodesForSelected(sel, (hc, assets) => {
        const printContainer = document.createElement("div");
        assets.forEach((asset, i) => {
          const div = hc.querySelectorAll("div")[i];
          const c   = div.querySelector("canvas");
          if (!c) return;
          const img = new Image();
          img.src          = c.toDataURL("image/png");
          img.style.width  = "40mm";
          img.style.height = "25mm";
          img.style.display = "block";
          img.style.margin  = "0 auto";

          const item = document.createElement("div");
          item.style.textAlign = "center";
          item.style.marginBottom = "20px";
          item.appendChild(img);

          // Only Asset ID below QR
          const caption = document.createElement("p");
          caption.textContent = `Asset ID: ${asset.assetId}`;
          item.appendChild(caption);

          printContainer.appendChild(item);
        });

        const original = document.body.innerHTML;
        document.body.innerHTML = printContainer.innerHTML;
        window.print();
        document.body.innerHTML = original;
        document.body.removeChild(hc);
      });
    });

    // 9. Close modal: go to Landing
    document.getElementById("closeQrModal").addEventListener("click", () => {
      window.location.href = "/Home/Landing";
    });
  });
</script>

</body>
</html>
